# Copy to .env for local use. On Vercel, set these in Project Settings > Environment Variables.
AI_ENABLED=true
AI_EXPLAIN_ENABLED=false
AI_MODEL=google/gemini-2.5-flash
AI_GATEWAY_API_KEY=            # local only; on Vercel the function uses its OIDC token
AI_DAILY_CAP=50
DATABASE_URL=                  # set automatically by the Neon integration on Vercel
SHARING_ENABLED=true
NREL_API_KEY=                  # only for tools/build_yield_table.py --source pvwatts; never deployed
