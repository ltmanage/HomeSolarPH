# Optional settings. The app runs without any of them.
# Locally: copy to .env. On Vercel: Project Settings > Environment Variables.

# Reading uploaded quotes automatically (without a key, quotes are typed in)
GEMINI_API_KEY=
AI_MODEL=                 # optional model override
AI_DAILY_CAP=50

# Opt-in anonymous sharing and feedback (without it, sharing is hidden)
DATABASE_URL=             # Postgres connection string; tables in db/schema.sql
